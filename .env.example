# Configuration template only. Do not place real credentials here.
# During M0, copy the backend variables into backend/.env and the frontend
# variables into frontend/.env.local. Those local files remain gitignored.

# Backend
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/helpdesk_mini
JWT_SECRET=replace-with-a-strong-local-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated explicit origins; wildcard origins are incompatible with cookies.
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
