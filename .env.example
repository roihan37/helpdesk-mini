# Configuration template only. Do not place real credentials here.
# Copy the backend variables into backend/.env and the frontend variables into
# frontend/.env.local. Those local files remain gitignored.

# Backend
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/helpdesk_mini
JWT_SECRET=replace-with-a-strong-local-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=false
# Use none only for cross-site HTTPS cookies with Secure=true and explicit CORS.
REFRESH_COOKIE_SAMESITE=lax
# Comma-separated explicit origins; wildcard origins are incompatible with cookies.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Login: sliding windows, keyed by normalized email + peer IP, and by peer IP.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILED_WINDOW_SECONDS=900
LOGIN_IP_MAX_REQUESTS=30
LOGIN_IP_WINDOW_SECONDS=60

# Private chat image storage. Local is the default; no AWS account is required.
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=.uploads/attachments
# Optional S3: set STORAGE_PROVIDER=s3, region and an existing private bucket.
# Leave keys empty to use the AWS SDK credential chain / IAM role.
# Never commit actual AWS credentials. Short-lived roles are preferred.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
AWS_S3_PREFIX=helpdesk-mini/attachments/

# Demo seed input (supply only to the seed command; do not store a real value here).
# DEMO_SEED_PASSWORD=choose-a-local-demo-only-password

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
